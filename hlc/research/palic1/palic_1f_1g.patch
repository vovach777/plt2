+// "1g": fNBLI's gradient-adjusted predictor (no bias correction, no contexts) instead of MED.
+// Neighbours: a left, b up, c up-left, d up-right, e left-left, f up-up, g up-up-right.
+// Band row 0: left (as MED). Row 1: f = b, g = d. x = 0: a = c = e = b; x = 1: e = a; last column: d = b, g = f.
+// LO..HI: the sample range (Y 0..255, U/V -256..255); fNBLI works on offset samples, the shift is exact here.
+template <bool NINE>
+static inline int16_t gap_pred(int16_t a, int16_t b, int16_t c, int16_t d, int16_t e, int16_t f, int16_t g) {
+    constexpr int16_t LO = NINE ? -256 : 0, HI = 255;
+    auto ab_ = [](int16_t v) { return int16_t(v < 0 ? -v : v); };
+    const int16_t dh = int16_t(ab_(int16_t(a - e)) + ab_(int16_t(b - c)) + ab_(int16_t(b - d)));
+    const int16_t dv = int16_t(ab_(int16_t(a - c)) + ab_(int16_t(b - f)) + ab_(int16_t(d - g)));
+    int16_t dvh = int16_t(dv - dh);
+    const int16_t ab = dvh > 0 ? a : b;
+    dvh = ab_(dvh);
+    int16_t px = int16_t((a + b) * 9 + (d << 1) - (c << 1) - e - f);
+    px = px < int16_t(16 * LO) ? int16_t(16 * LO) : px;
+    px = px > int16_t(16 * HI) ? int16_t(16 * HI) : px;
+    const int16_t pa = int16_t((px + (ab << 4) + 16) >> 5), pb = int16_t((3 * px + (ab << 4) + 32) >> 6), p0 = int16_t((px + 8) >> 4);
+    int16_t p = p0;
+    p = dvh > 8 ? pb : p;
+    p = dvh > 32 ? pa : p;
+    p = dvh > 80 ? ab : p;
+    return p;
+}
+template <bool NINE>
+static void predict_row_gap(const int16_t* __restrict cur, const int16_t* __restrict up, const int16_t* __restrict up2,
+                            int y, int width, uint16_t* __restrict z) {
+    if (y == 0) {
+        z[0] = wrap_zigzag<NINE>(cur[0]);
+        for (int x = 1; x < width; ++x) z[x] = wrap_zigzag<NINE>(int16_t(cur[x] - cur[x - 1]));
+        return;
+    }
+    for (int x = 0; x < width; ++x) {
+        const int16_t b = up[x];
+        const int16_t a = x ? cur[x - 1] : b, c = x ? up[x - 1] : b, e = x >= 2 ? cur[x - 2] : a;
+        const int16_t d = x + 1 < width ? up[x + 1] : b;
+        const int16_t f = y >= 2 ? up2[x] : b;
+        const int16_t g = y >= 2 ? (x + 1 < width ? up2[x + 1] : f) : d;
+        z[x] = wrap_zigzag<NINE>(int16_t(cur[x] - gap_pred<NINE>(a, b, c, d, e, f, g)));
+    }
+}
